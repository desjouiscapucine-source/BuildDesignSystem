{
  "$description": "Chip design preview tokens (stage 1). Approved by the Design System Lead: the look of the chips used on the documentation site to switch views (Backlog category filter, Design preview variant switch), text only, no disabled state, prop 'selected' (variant 'selected'), long label cut with an ellipsis on one line. Values: body text style, space.4 / space.16 padding, radius.8, 1px border.strong on the page background; selected = background.brand + text.inverse. Hover / focus / pressed use the state layers. 'surface' is the context background, not part of the chip.",
  "text": "Components",
  "slots": {
    "surface": {
      "type": "color",
      "description": "Context: background the chip sits on"
    },
    "background": {
      "type": "color",
      "description": "Chip background"
    },
    "text": {
      "type": "color",
      "description": "Label color"
    },
    "border": {
      "type": "color",
      "description": "Chip border color"
    },
    "border-width": {
      "type": "border-width",
      "description": "Chip border width"
    },
    "padding-x": {
      "type": "space",
      "description": "Horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Vertical padding"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    },
    "focus": {
      "type": "color",
      "description": "Focus outline color"
    }
  },
  "variants": {
    "default": {
      "surface": "color.background.page",
      "background": "color.background.page",
      "text": "color.text.primary",
      "border": "color.border.strong",
      "border-width": "border-width.1",
      "padding-x": "space.16",
      "padding-y": "space.4",
      "radius": "radius.8",
      "label": "body",
      "focus": "color.border.focus"
    },
    "selected": {
      "surface": "color.background.page",
      "background": "color.background.brand",
      "text": "color.text.inverse",
      "border": "color.background.brand",
      "border-width": "border-width.1",
      "padding-x": "space.16",
      "padding-y": "space.4",
      "radius": "radius.8",
      "label": "body",
      "focus": "color.border.focus"
    }
  },
  "contrast": [
    {
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "border",
      "background": "surface",
      "min": 3
    }
  ],
  "previewStates": [
    "default",
    "hover",
    "focus",
    "pressed"
  ]
}
