{
  "$description": "TicketCard design preview tokens (stage 1). Proposals until approved by the Design System Lead. Container, title and description use the look of Card (approved: Card's look, own clickable container). Tags and menus are placeholders until Tag (B059) and Select (B021) are coded.",
  "text": "TicketCard",
  "previewStates": [
    "default",
    "hover",
    "focus",
    "pressed"
  ],
  "previewMinWidth": "320px",
  "slots": {
    "background": {
      "type": "color",
      "description": "Card background"
    },
    "border": {
      "type": "color",
      "description": "Border color"
    },
    "border-width": {
      "type": "border-width",
      "description": "Border width"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "padding": {
      "type": "space",
      "description": "Inner padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between the rows (tags, title, description, menus)"
    },
    "tags-gap": {
      "type": "space",
      "description": "Space between the tags and the ID"
    },
    "id": {
      "type": "text-style",
      "description": "ID text style"
    },
    "id-color": {
      "type": "color",
      "description": "ID color"
    },
    "title": {
      "type": "text-style",
      "description": "Title text style"
    },
    "title-color": {
      "type": "color",
      "description": "Title color"
    },
    "description": {
      "type": "text-style",
      "description": "Description text style"
    },
    "description-color": {
      "type": "color",
      "description": "Description color"
    },
    "menus-gap": {
      "type": "space",
      "description": "Space between the menus"
    }
  },
  "variants": {
    "default": {
      "background": "color.background.page",
      "border": "color.border.subtle",
      "border-width": "border-width.1",
      "radius": "radius.8",
      "padding": "space.16",
      "gap": "space.8",
      "tags-gap": "space.16",
      "id": "body-sm",
      "id-color": "color.text.secondary",
      "title": "heading-5",
      "title-color": "color.text.primary",
      "description": "body",
      "description-color": "color.text.primary",
      "menus-gap": "space.8"
    }
  },
  "contrast": [
    {
      "foreground": "title-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "description-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "id-color",
      "background": "background",
      "min": 4.5
    }
  ]
}
