{
  "$description": "TextInput design preview tokens (stage 1). Proposals until approved by the Design System Lead, aligned on the Select. Variants: empty (placeholder + help text), filled, with-icon (leading icon), search (search icon, clear button), number (digits only), error (error border, the error message replaces the help text). Disabled uses the disabled roles. No visible label above the field (Design System Lead, 2026-11-19): the empty field shows either a label or a placeholder, never both.",
  "text": "Primary button",
  "slots": {
    "page": {
      "type": "color",
      "description": "Context: page background"
    },
    "background": {
      "type": "color",
      "description": "Field background"
    },
    "border": {
      "type": "color",
      "description": "Field border color"
    },
    "border-width": {
      "type": "border-width",
      "description": "Field border width"
    },
    "radius": {
      "type": "radius",
      "description": "Field corner radius"
    },
    "padding-x": {
      "type": "space",
      "description": "Field horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Field vertical padding"
    },
    "value": {
      "type": "text-style",
      "description": "Value and placeholder text style"
    },
    "text": {
      "type": "color",
      "description": "Value color"
