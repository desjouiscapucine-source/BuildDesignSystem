    "icon-gap": {
      "type": "space",
      "description": "Space between icon and text"
    },
    "help-text": {
      "type": "color",
      "description": "Help text color"
    },
    "message": {
      "type": "text-style",
      "description": "Help text and error message text style"
    },
    "error-text": {
      "type": "color",
      "description": "Error message color"
    },
    "error-icon": {
      "type": "color",
      "description": "Error icon color"
    },
    "message-gap": {
      "type": "space",
      "description": "Space between field and help text or error message"
    }
  },
