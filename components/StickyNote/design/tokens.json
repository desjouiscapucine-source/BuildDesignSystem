{
  "$description": "StickyNote design preview tokens (stage 1). Approved by the Design System Lead: one color (background.brand-subtle), one fixed size (size.sticky-note, 160 × 160), radius.4 + shadow.frame, text in body, author in label-sm, date in body-sm, Delete and Edit as tertiary IconButtons always visible in the footer. Also approved: padding space.8, gaps space.8 / space.4, text and author and date in text.primary, 4 lines max; selected and editing: border.strong 2px, no state layer; dragging: shadow.hover. the selected, editing and dragging states are shown as variants, since the preview states are only default / hover / focus / pressed).",
  "text": "Check the spacing between the cards and the timeline on mobile.",
  "previewStates": [
    "default",
    "hover",
    "focus"
  ],
  "previewMinWidth": "200px",
  "slots": {
    "background": {
      "type": "color",
      "description": "Note background"
    },
    "border": {
      "type": "color",
      "description": "Border color (selected state)"
    },
    "border-width": {
      "type": "border-width",
      "description": "Border width"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "shadow": {
      "type": "shadow",
      "description": "Shadow"
    },
    "padding": {
      "type": "space",
      "description": "Inner padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between the text and the footer"
    },
    "body": {
      "type": "text-style",
      "description": "Note text style"
    },
    "body-color": {
      "type": "color",
      "description": "Note text color"
    },
    "author": {
      "type": "text-style",
      "description": "Author text style"
    },
    "author-color": {
      "type": "color",
      "description": "Author color"
    },
    "date": {
      "type": "text-style",
      "description": "Date text style"
    },
    "date-color": {
      "type": "color",
      "description": "Date color"
    },
    "actions-gap": {
      "type": "space",
      "description": "Space between the author / date and the actions, and between the two actions"
    }
  },
  "variants": {
    "default": {
      "background": "color.background.brand-subtle",
      "border": "color.background.brand-subtle",
      "border-width": "border-width.0",
      "radius": "radius.4",
      "shadow": "shadow.frame",
      "padding": "space.8",
      "gap": "space.8",
      "body": "body",
      "body-color": "color.text.primary",
      "author": "label-sm",
      "author-color": "color.text.primary",
      "date": "body-sm",
      "date-color": "color.text.primary",
      "actions-gap": "space.4"
    },
    "selected": {
      "background": "color.background.brand-subtle",
      "border": "color.border.strong",
      "border-width": "border-width.2",
      "radius": "radius.4",
      "shadow": "shadow.frame",
      "padding": "space.8",
      "gap": "space.8",
      "body": "body",
      "body-color": "color.text.primary",
      "author": "label-sm",
      "author-color": "color.text.primary",
      "date": "body-sm",
      "date-color": "color.text.primary",
      "actions-gap": "space.4"
    },
    "editing": {
      "background": "color.background.brand-subtle",
      "border": "color.border.strong",
      "border-width": "border-width.2",
      "radius": "radius.4",
      "shadow": "shadow.frame",
      "padding": "space.8",
      "gap": "space.8",
      "body": "body",
      "body-color": "color.text.primary",
      "author": "label-sm",
      "author-color": "color.text.primary",
      "date": "body-sm",
      "date-color": "color.text.primary",
      "actions-gap": "space.4"
    },
    "dragging": {
      "background": "color.background.brand-subtle",
      "border": "color.background.brand-subtle",
      "border-width": "border-width.0",
      "radius": "radius.4",
      "shadow": "shadow.hover",
      "padding": "space.8",
      "gap": "space.8",
      "body": "body",
      "body-color": "color.text.primary",
      "author": "label-sm",
      "author-color": "color.text.primary",
      "date": "body-sm",
      "date-color": "color.text.primary",
      "actions-gap": "space.4"
    }
  },
  "contrast": [
    {
      "foreground": "body-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "author-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "date-color",
      "background": "background",
      "min": 4.5
    }
  ]
}
