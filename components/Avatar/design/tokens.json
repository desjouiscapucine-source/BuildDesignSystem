{
  "$description": "Avatar design preview tokens (stage 1). Decided by the Design System Lead on 2026-11-21/22 (B159): round, content initials (uppercase, two letters for first + last name, one for a one-word name; first + last word for 3+ words; full name announced) or, without a name, the icon (decorative) 'person', colors background.brand + text.inverse / icon.inverse, three sizes small / medium / large (default medium) with diameters space.24 / space.32 / space.48, initials label-sm / label / heading-5, icon icon-size.16 / 20 / 32. Not interactive: default state only.",
  "text": "Capucine Desjouis",
  "slots": {
    "background": {
      "type": "color",
      "description": "Circle background"
    },
    "text": {
      "type": "color",
      "description": "Initials color"
    },
    "icon": {
      "type": "color",
      "description": "Icon color (no initials)"
    },
    "diameter": {
      "type": "space",
      "description": "Width and height of the circle"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius (round)"
    },
    "initials": {
      "type": "text-style",
      "description": "Initials text style"
    },
    "icon-size": {
      "type": "icon-size",
      "description": "Icon size"
    }
  },
  "variants": {
    "small": {
      "background": "color.background.brand",
      "text": "color.text.inverse",
      "icon": "color.icon.inverse",
      "diameter": "space.24",
      "radius": "radius.full",
      "initials": "label-sm",
      "icon-size": "icon-size.16"
    },
    "medium": {
      "background": "color.background.brand",
      "text": "color.text.inverse",
      "icon": "color.icon.inverse",
      "diameter": "space.32",
      "radius": "radius.full",
      "initials": "label",
      "icon-size": "icon-size.20"
    },
    "large": {
      "background": "color.background.brand",
      "text": "color.text.inverse",
      "icon": "color.icon.inverse",
      "diameter": "space.48",
      "radius": "radius.full",
      "initials": "heading-5",
      "icon-size": "icon-size.32"
    }
  },
  "previewStates": [
    "default"
  ],
  "contrast": [
    {
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "icon",
      "background": "background",
      "min": 3
    }
  ]
}
