{
  "$description": "Tab design preview tokens (stage 1). Decided by the Design System Lead on 2026-11-19: underline style, one size, text label only; label body + color.text.secondary, selected label (body semibold = label style) in color.text.brand with an indicator border-width.2 in color.border.focus; padding space.8 / space.16; states hover, focus, pressed (state layers, top corners radius.4) and disabled (color.text.disabled); long label on one line, the tab grows. 'surface' is the context background, not part of the tab.",
  "text": "Guidelines",
  "slots": {
    "surface": {
      "type": "color",
      "description": "Context: background the tab sits on"
    },
    "text": {
      "type": "color",
      "description": "Label color"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    },
    "indicator": {
      "type": "color",
      "description": "Selection line under the selected tab"
    },
    "indicator-width": {
      "type": "border-width",
      "description": "Thickness of the selection line"
    },
    "padding-x": {
      "type": "space",
      "description": "Left and right padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Top and bottom padding"
    },
    "radius": {
      "type": "radius",
      "description": "Top corners of the state layer and focus ring"
    },
    "focus": {
      "type": "color",
      "description": "Focus outline color"
    }
  },
  "variants": {
    "default": {
      "surface": "color.background.page",
      "text": "color.text.secondary",
      "label": "body",
      "indicator": "color.border.focus",
      "indicator-width": "border-width.2",
      "padding-x": "space.16",
      "padding-y": "space.8",
      "radius": "radius.4",
      "focus": "color.border.focus"
    },
    "selected": {
      "surface": "color.background.page",
      "text": "color.text.brand",
      "label": "label",
      "indicator": "color.border.focus",
      "indicator-width": "border-width.2",
      "padding-x": "space.16",
      "padding-y": "space.8",
      "radius": "radius.4",
      "focus": "color.border.focus"
    }
  },
  "states": {
    "disabled": {
      "text": "color.text.disabled"
    }
  },
  "contrast": [
    {
      "foreground": "text",
      "background": "surface",
      "min": 4.5
    },
    {
      "foreground": "indicator",
      "background": "surface",
      "min": 3
    }
  ]
}
