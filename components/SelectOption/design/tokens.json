{
  "$description": "SelectOption design preview tokens (stage 1). Proposals until approved by the Design System Lead. 'surface' is the context background (the Select list), not part of the option. Each variant shows the option without and with a leading icon. The check mark (on the right) is shown on the selected option only. Disabled uses the disabled roles.",
  "text": "In progress",
  "slots": {
    "surface": {
      "type": "color",
      "description": "Context: background of the list the option sits on"
    },
    "background": {
      "type": "color",
      "description": "Option background (none = transparent)"
    },
    "text": {
      "type": "color",
      "description": "Label color"
    },
    "icon": {
      "type": "color",
      "description": "Leading icon color"
    },
    "check": {
      "type": "color",
      "description": "Check mark color (selected only)"
    },
    "padding-x": {
      "type": "space",
      "description": "Horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Vertical padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between icon, label and check mark"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "icon-size": {
      "type": "icon-size",
      "description": "Icon and check mark size"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    }
  },
  "variants": {
    "default": {
      "surface": "color.background.surface",
      "text": "color.text.primary",
      "icon": "color.icon.secondary",
      "check": "color.icon.brand",
      "padding-x": "space.8",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "body"
    },
    "selected": {
      "surface": "color.background.surface",
      "text": "color.text.brand",
      "icon": "color.icon.brand",
      "check": "color.icon.brand",
      "padding-x": "space.8",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "label",
      "background": "color.background.brand-subtle"
    }
  },
  "states": {
    "disabled": {
      "text": "color.text.disabled",
      "icon": "color.icon.disabled",
      "check": "color.icon.disabled"
    }
  },
  "contrast": [
    {
      "foreground": "text",
      "background": "surface",
      "min": 4.5
    },
    {
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "icon",
      "background": "surface",
      "min": 3
    },
    {
      "foreground": "check",
      "background": "background",
      "min": 3
    }
  ]
}
