{
  "$description": "ZoomControls design preview tokens (stage 1). Decided by the Design System Lead (B161). The Content field sets the zoom level in percent (10 → 400): zoom out is disabled at 10, zoom in at 400. The buttons are tertiary IconButtons (complete); their states are those of IconButton.",
  "text": "100",
  "previewStates": [
    "default"
  ],
  "slots": {
    "background": { "type": "color", "description": "Container background" },
    "shadow": { "type": "shadow", "description": "Shadow of the container over the canvas" },
    "radius": { "type": "radius", "description": "Container corner radius" },
    "padding": { "type": "space", "description": "Container padding" },
    "gap": { "type": "space", "description": "Space between the parts" },
    "level": { "type": "text-style", "description": "Zoom level text style" },
    "level-color": { "type": "color", "description": "Zoom level text color" },
    "divider-color": { "type": "color", "description": "Divider between zoom in and fit to screen" },
    "divider-width": { "type": "border-width", "description": "Divider width" },
    "divider-height": { "type": "icon-size", "description": "Divider height (icon height)" }
  },
  "variants": {
    "default": {
      "background": "color.background.surface",
      "shadow": "shadow.dropdown",
      "radius": "radius.8",
      "padding": "space.4",
      "gap": "space.4",
      "level": "label-sm",
      "level-color": "color.text.primary",
      "divider-color": "color.border.subtle",
      "divider-width": "border-width.1",
      "divider-height": "icon-size.20"
    }
  },
  "contrast": [
    { "foreground": "level-color", "background": "background", "min": 4.5 }
  ]
}
