{
  "$description": "Dialog design preview tokens (stage 1). Proposals until approved by the Design System Lead.",
  "text": "Delete this ticket?",
  "previewStates": [
    "default"
  ],
  "previewMinWidth": "880px",
  "slots": {
    "overlay": {
      "type": "color",
      "description": "Dimmed background behind the dialog"
    },
    "background": {
      "type": "color",
      "description": "Dialog background"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "shadow": {
      "type": "shadow",
      "description": "Shadow"
    },
    "padding": {
      "type": "space",
      "description": "Inner padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between header, body and footer"
    },
    "header-gap": {
      "type": "space",
      "description": "Space between the title and the description"
    },
    "actions-gap": {
      "type": "space",
      "description": "Space between the footer buttons"
    },
    "title": {
      "type": "text-style",
      "description": "Title text style"
    },
    "title-color": {
      "type": "color",
      "description": "Title color"
    },
    "description": {
      "type": "text-style",
      "description": "Description text style"
    },
    "description-color": {
      "type": "color",
      "description": "Description color"
    },
    "body": {
      "type": "text-style",
      "description": "Body text style"
    },
    "body-color": {
      "type": "color",
      "description": "Body text color"
    }
  },
  "variants": {
    "medium": {
      "overlay": "color.background.overlay",
      "background": "color.background.page",
      "radius": "radius.8",
      "shadow": "shadow.dialog",
      "padding": "space.24",
      "gap": "space.24",
      "header-gap": "space.4",
      "actions-gap": "space.8",
      "title": "heading-4",
      "title-color": "color.text.primary",
      "description": "body",
      "description-color": "color.text.secondary",
      "body": "body",
      "body-color": "color.text.primary"
    },
    "small": {
      "overlay": "color.background.overlay",
      "background": "color.background.page",
      "radius": "radius.8",
      "shadow": "shadow.dialog",
      "padding": "space.24",
      "gap": "space.24",
      "header-gap": "space.4",
      "actions-gap": "space.8",
      "title": "heading-4",
      "title-color": "color.text.primary",
      "description": "body",
      "description-color": "color.text.secondary",
      "body": "body",
      "body-color": "color.text.primary"
    },
    "large": {
      "overlay": "color.background.overlay",
      "background": "color.background.page",
      "radius": "radius.8",
      "shadow": "shadow.dialog",
      "padding": "space.24",
      "gap": "space.24",
      "header-gap": "space.4",
      "actions-gap": "space.8",
      "title": "heading-4",
      "title-color": "color.text.primary",
      "description": "body",
      "description-color": "color.text.secondary",
      "body": "body",
      "body-color": "color.text.primary"
    }
  },
  "contrast": [
    {
      "foreground": "title-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "description-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "body-color",
      "background": "background",
      "min": 4.5
    }
  ]
}
