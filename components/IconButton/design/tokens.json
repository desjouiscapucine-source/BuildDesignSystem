{
  "$description": "IconButton design preview tokens (stage 1). Proposals until approved by the Design System Lead.",
  "text": "timeline",
  "slots": {
    "background": { "type": "color", "description": "Background (none = transparent)" },
    "icon": { "type": "color", "description": "Icon color" },
    "padding": { "type": "space", "description": "Padding around the icon" },
    "radius": { "type": "radius", "description": "Corner radius" },
    "icon-size": { "type": "icon-size", "description": "Icon size" },
    "focus": { "type": "color", "description": "Focus outline color" }
  },
  "variants": {
    "primary": { "background": "color.background.brand", "icon": "color.icon.inverse", "padding": "space.8", "radius": "radius.8", "icon-size": "icon-size.20", "focus": "color.border.focus" },
    "secondary": { "background": "color.background.brand-subtle", "icon": "color.icon.primary", "padding": "space.8", "radius": "radius.8", "icon-size": "icon-size.20", "focus": "color.border.focus" },
    "tertiary": { "icon": "color.icon.brand", "padding": "space.8", "radius": "radius.8", "icon-size": "icon-size.20", "focus": "color.border.focus" }
  },
  "states": {
    "disabled": { "background": "color.background.disabled", "icon": "color.icon.disabled" }
  },
  "variantStates": { "tertiary": { "disabled": { "background": "" } } },
  "contrast": [
    { "foreground": "icon", "background": "background", "min": 3 }
  ]
}
