{
  "$description": "TimelineStep design preview tokens (stage 1). Proposals until approved by the Design System Lead.",
  "text": "Order",
  "slots": {
    "marker": {
      "type": "color",
      "description": "Marker (dot) fill"
    },
    "marker-border": {
      "type": "color",
      "description": "Marker outline color"
    },
    "marker-border-width": {
      "type": "border-width",
      "description": "Marker outline width"
    },
    "marker-size": {
      "type": "space",
      "description": "Marker (dot) diameter"
    },
    "line": {
      "type": "color",
      "description": "Line to the next step"
    },
    "line-width": {
      "type": "border-width",
      "description": "Line width"
    },
    "gap": {
      "type": "space",
      "description": "Space between the marker column and the content"
    },
    "content-gap": {
      "type": "space",
      "description": "Space between date, title and description"
    },
    "title-date-gap": {
      "type": "space",
      "description": "Space between the title and the date range"
    },
    "spacing": {
      "type": "space",
      "description": "Space below a step (before the next one)"
    },
    "date": {
      "type": "text-style",
      "description": "Date text style"
    },
    "date-color": {
      "type": "color",
      "description": "Date color"
    },
    "title": {
      "type": "text-style",
      "description": "Title text style"
    },
    "title-color": {
      "type": "color",
      "description": "Title color"
    },
    "description": {
      "type": "text-style",
      "description": "Description text style"
    },
    "description-color": {
      "type": "color",
      "description": "Description color"
    },
    "padding": {
      "type": "space",
      "description": "Padding of the clickable area"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius of the clickable area"
    },
    "focus": {
      "type": "color",
      "description": "Focus outline color"
    }
  },
  "variants": {
