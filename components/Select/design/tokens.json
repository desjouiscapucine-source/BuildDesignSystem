{
  "$description": "Select design preview tokens (stage 1). Proposals until approved by the Design System Lead. 'page' is the context background. Variants: placeholder (no option chosen), filled (an option chosen), open (list shown, SelectOption building block), error (error border and message). Disabled uses the disabled roles.",
  "text": "In progress",
  "slots": {
    "page": {
      "type": "color",
      "description": "Context: page background"
    },
    "label-text": {
      "type": "color",
      "description": "Label color"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    },
    "label-gap": {
      "type": "space",
      "description": "Space between label and field"
    },
    "background": {
      "type": "color",
      "description": "Field background"
    },
    "border": {
      "type": "color",
      "description": "Field border color"
    },
    "border-width": {
      "type": "border-width",
      "description": "Field border width"
    },
    "radius": {
      "type": "radius",
      "description": "Field and list corner radius"
    },
    "padding-x": {
      "type": "space",
      "description": "Field horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Field vertical padding"
    },
    "value": {
      "type": "text-style",
      "description": "Value and placeholder text style"
    },
    "text": {
      "type": "color",
      "description": "Value color"
    },
    "placeholder": {
      "type": "color",
      "description": "Placeholder color"
    },
    "arrow": {
      "type": "color",
      "description": "Arrow (expand_more) color"
