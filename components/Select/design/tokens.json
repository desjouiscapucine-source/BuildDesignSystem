    "list-background": {
      "type": "color",
      "description": "List background"
    },
    "list-border": {
      "type": "color",
      "description": "List border color"
    },
    "list-padding": {
      "type": "space",
      "description": "List inner padding"
    },
    "list-gap": {
      "type": "space",
      "description": "Space between options"
    },
    "list-offset": {
      "type": "space",
      "description": "Space between field and list"
    },
    "message-text": {
      "type": "color",
      "description": "Error message color"
    },
    "message": {
      "type": "text-style",
      "description": "Error message text style"
    },
    "message-icon": {
      "type": "color",
      "description": "Error icon color"
    }
