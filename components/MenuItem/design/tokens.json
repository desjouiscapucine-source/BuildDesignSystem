{
  "$description": "MenuItem design preview tokens (stage 1). Proposals until approved by the Design System Lead. 'surface' is the context background (the Menu panel), not part of the item. The item is a tile: an icon above a centered one-line label. Disabled uses the disabled roles.",
  "text": "Mail",
  "slots": {
    "surface": {
      "type": "color",
      "description": "Context: background of the menu the item sits on"
    },
    "background": {
      "type": "color",
      "description": "Tile background"
    },
    "text": {
      "type": "color",
      "description": "Label color"
    },
    "icon": {
      "type": "color",
      "description": "Icon color"
    },
    "padding-x": {
      "type": "space",
      "description": "Horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Vertical padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between icon and label"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "icon-size": {
      "type": "icon-size",
      "description": "Icon size"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    }
  },
  "variants": {
    "default": {
      "surface": "color.background.surface",
      "text": "color.text.inverse",
      "icon": "color.icon.inverse",
      "padding-x": "space.8",
      "padding-y": "space.16",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.32",
      "label": "body-sm",
      "background": "color.background.brand"
    }
  },
  "states": {
    "disabled": {
      "text": "color.text.disabled",
      "icon": "color.icon.disabled"
    }
  },
  "contrast": [
    {
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "icon",
      "background": "background",
      "min": 3
    }
  ]
}