{
  "$description": "NavigationItem design preview tokens (stage 1). Proposals until approved by the Design System Lead. 'surface' is the context background (the side navigation), not part of the item. Disabled: the whole item uses opacity.disabled (0.38) \u2014 shown by the preview.",
  "text": "Dashboard",
  "slots": {
    "surface": {
      "type": "color",
      "description": "Context: background the item sits on (brand)"
    },
    "background": {
      "type": "color",
      "description": "Item background (none = transparent)"
    },
    "text": {
      "type": "color",
      "description": "Label color"
    },
    "icon": {
      "type": "color",
      "description": "Icon color"
    },
    "padding-x": {
      "type": "space",
      "description": "Horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Vertical padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between icon, label and counter"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "icon-size": {
      "type": "icon-size",
      "description": "Icon size"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    },
    "focus": {
      "type": "color",
      "description": "Focus outline color (on the brand surface)"
    }
  },
  "variants": {
    "default": {
      "surface": "color.background.brand",
      "text": "color.text.inverse",
      "icon": "color.icon.inverse",
      "padding-x": "space.8",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "body",
      "focus": "color.border.focus-inverse"
    },
    "selected": {
      "surface": "color.background.brand",
      "background": "color.background.brand-subtle",
      "text": "color.text.brand",
      "icon": "color.icon.brand",
      "padding-x": "space.8",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "label",
      "focus": "color.border.focus-inverse"
    }
  },
  "states": {
    "disabled": {}
  },
  "contrast": [
    {
      "foreground": "text",
      "background": "surface",
      "min": 4.5
    },
    {
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
