{
  "$description": "Button design preview tokens (stage 1). Proposals until approved by the Design System Lead. 'variantStates' overrides slots for one variant in one state (empty string = no token).",
  "text": "label",
  "slots": {
    "background": {
      "type": "color",
      "description": "Container background (none = transparent)"
    },
    "text": {
      "type": "color",
      "description": "Label color"
    },
    "icon": {
      "type": "color",
      "description": "Leading icon color"
    },
    "border": {
      "type": "color",
      "description": "Container border color"
    },
    "border-width": {
      "type": "border-width",
      "description": "Container border width"
    },
    "padding-x": {
      "type": "space",
      "description": "Horizontal padding"
    },
    "padding-y": {
      "type": "space",
      "description": "Vertical padding"
    },
    "gap": {
      "type": "space",
      "description": "Space between icon and label"
    },
    "radius": {
      "type": "radius",
      "description": "Corner radius"
    },
    "icon-size": {
      "type": "icon-size",
      "description": "Leading icon size"
    },
    "label": {
      "type": "text-style",
      "description": "Label text style"
    }
  },
  "variants": {
    "primary": {
      "background": "color.background.brand",
      "text": "color.text.inverse",
      "icon": "color.icon.inverse",
      "border": "color.background.brand",
      "border-width": "border-width.0",
      "padding-x": "space.16",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "label"
    },
    "secondary": {
      "background": "color.background.brand-subtle",
      "text": "color.text.primary",
      "icon": "color.icon.primary",
      "border": "color.border.strong",
      "border-width": "border-width.0",
      "padding-x": "space.16",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "label"
    },
    "tertiary": {
      "text": "color.text.brand",
      "icon": "color.icon.brand",
      "border": "color.border.strong",
      "border-width": "border-width.0",
      "padding-x": "space.16",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "label"
    },
    "danger": {
      "background": "color.background.error-subtle",
      "text": "color.text.error",
      "icon": "color.icon.error",
      "border": "color.background.error-subtle",
      "border-width": "border-width.0",
      "padding-x": "space.16",
      "padding-y": "space.8",
      "gap": "space.8",
      "radius": "radius.8",
      "icon-size": "icon-size.20",
      "label": "label"
    }
  },
  "states": {
    "disabled": {
      "background": "color.background.disabled",
      "text": "color.text.disabled",
      "icon": "color.icon.disabled",
      "border": "color.border.subtle"
    }
  },
  "contrast": [
    {
      "foreground": "text",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "icon",
      "background": "background",
      "min": 3
    }
  ],
  "variantStates": {
    "tertiary": {
      "disabled": {
        "background": ""
      }
    }
  }
}
