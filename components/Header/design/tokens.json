{
  "$description": "Header design preview tokens (stage 1). Proposals until approved by the Design System Lead; the values are those of the current documentation site header. The logo, the search field and the icon buttons are the coded components (TextInput, IconButton).",
  "text": "BuildDesignSystem",
  "slots": {
    "background": { "type": "color", "description": "Header background" },
    "text": { "type": "color", "description": "Brand name color" },
    "border": { "type": "color", "description": "Bottom border color" },
    "border-width": { "type": "border-width", "description": "Bottom border width" },
    "padding-x": { "type": "space", "description": "Horizontal padding" },
    "gap": { "type": "space", "description": "Space between the parts" },
    "brand": { "type": "text-style", "description": "Brand name text style" }
  },
  "variants": {
    "default": {
      "background": "color.background.brand-subtle",
      "text": "color.text.primary",
      "border": "color.border.default",
      "border-width": "border-width.1",
      "padding-x": "space.24",
      "gap": "space.16",
      "brand": "heading-5"
    }
  },
  "contrast": [
    { "foreground": "text", "background": "background", "min": 4.5 }
  ]
}
