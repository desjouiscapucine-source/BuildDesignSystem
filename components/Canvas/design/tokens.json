{
  "$description": "Canvas design preview tokens (stage 1). Proposals until approved by the Design System Lead.",
  "text": "Add a frame to start",
  "previewStates": [
    "default",
    "focus"
  ],
  "previewMinWidth": "480px",
  "slots": {
    "background": {
      "type": "color",
      "description": "Canvas background"
    },
    "dot": {
      "type": "color",
      "description": "Color of the dots of the grid"
    },
    "dot-size": {
      "type": "border-width",
      "description": "Diameter of a dot"
    },
    "dot-spacing": {
      "type": "space",
      "description": "Space between two dots, at 100% zoom"
    },
    "message": {
      "type": "text-style",
      "description": "Empty message text style"
    },
    "message-color": {
      "type": "color",
      "description": "Empty message color"
    },
    "focus-ring": {
      "type": "color",
      "description": "Keyboard focus outline, inside the edges of the canvas"
    },
    "focus-ring-width": {
      "type": "border-width",
      "description": "Keyboard focus outline width"
    },
    "selection": {
      "type": "color",
      "description": "Selection rectangle: border, and its fill at state-layer.hover"
    },
    "selection-width": {
      "type": "border-width",
      "description": "Selection rectangle border width"
    }
  },
  "variants": {
    "empty": {
      "background": "color.background.subtle",
      "dot": "color.border.subtle",
      "dot-size": "border-width.2",
      "dot-spacing": "space.16",
      "message": "body",
      "message-color": "color.text.secondary",
      "focus-ring": "color.border.focus",
      "focus-ring-width": "border-width.2",
      "selection": "color.border.focus",
      "selection-width": "border-width.1"
    },
    "selection": {
      "background": "color.background.subtle",
      "dot": "color.border.subtle",
      "dot-size": "border-width.2",
      "dot-spacing": "space.16",
      "message": "body",
      "message-color": "color.text.secondary",
      "focus-ring": "color.border.focus",
      "focus-ring-width": "border-width.2",
      "selection": "color.border.focus",
      "selection-width": "border-width.1"
    }
  },
  "contrast": [
    {
      "foreground": "message-color",
      "background": "background",
      "min": 4.5
    },
    {
      "foreground": "focus-ring",
      "background": "background",
      "min": 3
    },
    {
      "foreground": "selection",
      "background": "background",
      "min": 3
    }
  ]
}
